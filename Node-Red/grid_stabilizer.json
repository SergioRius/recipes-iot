[
    {
        "id": "7362584b235a0f78",
        "type": "function",
        "z": "456133deec6d609f",
        "name": "Calculate",
        "func": "const debug = global.get(\"settings.system.debug\") || false;\n\nif (!(global.get(\"settings.automations.GridStabilizer.Enabled\") || false)) return;\n\nconst target = global.get(\"settings.automations.GridStabilizer.Target\") || 0;\nconst setpoint = global.get(\"settings.victron.GridSetpoint\");\n\n// Matriz de valores\n// Se puede expandir como se desee.\n// Se podría también usar un PID, pero el flow sería algo más complicado.\nconst map = [\n    { \"c\": 300, \"s\": -100 },\n    { \"c\": 120, \"s\": -30 },\n    { \"c\": 30, \"s\": -20 },\n    { \"c\": 15, \"s\": -10 },\n    { \"c\": 0, \"s\": 0 },\n    { \"c\": -15, \"s\": 10 },\n    { \"c\": -30, \"s\": 20 },\n    { \"c\": -120, \"s\": 30 },\n    { \"c\": -300, \"s\": 100 }\n];\n////////////////////////////\n\nconst grid = msg.payload;\nconst delta = grid - target;\n\n// Yo aquí añadiría si el desvío es muy bajo, no hacer nada,\n// aunque también se puede conseguir ajustando la zona central de la matriz de arriba.\n\n// Activar y descativar según modo de red\n// O si realmente se desea vertido (setpoint original != 0)\n\n// node.warn(c);\n// node.warn(map);\n\nconst a = map.filter(p => delta >= p.c)[0] || null;\nconst b = map.filter(p => delta < p.c).reverse()[0] || null;\n\n// node.warn(a);\n// node.warn(b);\n\nvar c = 0;\n\nconst fill = msg.payload == setpoint ? \"green\" : \"blue\";\nconst shape = (context.get(\"shape\") || \"dot\") == \"dot\" ? \"ring\" : \"dot\";\ncontext.set(\"shape\", shape);\n\nif (a == null || b == null || a == b) {\n    if (a != null) c = a.s;\n    else if (b != null) c = b.s;\n    msg.payload = Math.round((setpoint + c) / 10) * 10;\n    if (debug)\n        node.status({ fill: fill, shape: shape, text: \"grid: \" + grid + \" => \" + setpoint + \" + \" + c + \" = \" + msg.payload });\n} else {\n    c = Math.round(((delta - a.c) / (b.c - a.c) * (b.s - a.s)) + a.s);\n    msg.payload = Math.round((setpoint + c) / 10) * 10;\n    if (debug)\n        node.status({ fill: fill, shape: shape, text: \"grid: \" + grid + \", delta: \" + delta + \", c: \" + c + ', in: ' + b.c + \"-\" + a.c + ', out: ' + b.s + \"-\" + a.s + \", sp: \" + msg.payload });\n}\n\nif (msg.payload > (msg.target + 5000)) msg.payload = msg.target + 5000;\nif (msg.payload < (msg.target - 5000)) msg.payload = msg.target - 5000;\n\nif (!debug)\n    node.status({ fill: fill, shape: shape, text: msg.payload });\n\nreturn { source: 'Auto_GridStabilizer', payload: msg.payload };",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
