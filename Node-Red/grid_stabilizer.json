    {
        "id": "521192d4142059ed",
        "type": "function",
        "z": "456133deec6d609f",
        "name": "Active ?",
        "func": "const isEnabled = global.get(\"settings.automations.GridStabilizer.Enabled\");\nconst isIBVEVBInactive = global.get(\"settings.automations.ibvebv.mode\") == 0 || global.get(\"settings.automations.ibvebv.Sleeping\") == true;\nconst isScheduledChargeActive = global.get(\"victron.status.ScheduledCharge.Active\");\nconst isBatteryLow = global.get(\"storage.battery.soc\") <= global.get(\"settings.battery.minsoc\");\n\n// $globalContext(\"settings.automations.GridStabilizer.Enabled\") = true\n// and ($globalContext(\"settings.automations.ibvebv.mode\") = 0 or $globalContext(\"settings.automations.ibvebv.Sleeping\") = true)\n// and $globalContext(\"victron.status.ScheduledCharge.Active\") = 0\nconst active = isEnabled && isIBVEVBInactive && !isScheduledChargeActive && !isBatteryLow;\nconst lastActive = flow.get(\"Active\");\n\n// node.warn({lastActive: lastActive, active: active});\n\nif (lastActive && !active)\n    node.send([null, { payload: global.get(\"settings.automations.GridStabilizer.Target\") || 0 }]);\n\nflow.set(\"Active\", active);\nnode.status({ fill: active ? \"green\" : \"gray\", shape: \"dot\", text: active });\n\nif (active) return [msg, null];",
